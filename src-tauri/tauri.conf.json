{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amvaj Sarmad",
  "version": "1.0.0",
  "identifier": "com.amvajsarmad.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Amvaj Sarmad",
        "url": "https://amvajsarmad.com",
        "userAgent": "Mozilla/5.0 (Linux; Android 14; Mobile; AmvajSarmadApp/1.0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36",
        "fullscreen": false,
        "resizable": true,
        "transparent": false,
        "zoomHotkeysEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "vulkan": false,
      "minSdkVersion": 26,
      "targetSdkVersion": 34,
      "compileSdkVersion": 34
    }
  },
  "plugins": {
    "opener": {
      "default": "system"
    }
  }
}
